{
  "description": "company-site repository workspace",
  "devDependencies": {
    "eslint": "9.39.2",
    "js-yaml": "4.3.1",
    "prettier": "3.6.2",
    "turbo": "2.6.3",
    "typescript": "5.9.2",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "name": "unisane-site",
  "packageManager": "pnpm@10.26.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check:cold-checkout": "node scripts/check-cold-checkout.mjs",
    "check:history-safety": "node scripts/check-history-safety.mjs",
    "check:local-readiness": "pnpm --filter @unisane-site/web check:local-readiness",
    "check:repository-boundary": "node scripts/check-repository-boundary.mjs",
    "check:source-safety": "node scripts/check-source-safety.mjs",
    "ci:verify": "pnpm check:source-safety && pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm verify:local-readiness && pnpm check:repository-boundary",
    "dev": "pnpm --filter @unisane-site/web dev",
    "lint": "turbo run lint",
    "refresh:local-readiness-baseline": "pnpm build && pnpm --filter @unisane-site/web refresh:local-readiness-baseline",
    "start": "pnpm --filter @unisane-site/web start",
    "test": "pnpm build && pnpm --filter @unisane-site/web test && pnpm test:cold-checkout-bindings",
    "test:cold-checkout-bindings": "node scripts/check-cold-checkout.mjs --test-action-bindings",
    "typecheck": "turbo run typecheck",
    "verify:local-readiness": "pnpm build && pnpm check:local-readiness"
  },
  "version": "0.0.0"
}
